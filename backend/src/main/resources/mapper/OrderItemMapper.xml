<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pandago.order.mapper.OrderItemMapper">

    <select id="selectByOrderIds" resultType="com.pandago.order.entity.OrderItem">
        SELECT id, order_id, product_id, product_name, product_image,
               unit_price, quantity, subtotal, created_at
        FROM order_item
        WHERE order_id IN
        <foreach collection="orderIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY order_id, id
    </select>

</mapper>
