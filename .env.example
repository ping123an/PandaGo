# ========== PandaGo 部署环境变量样例 ==========
# 用法：cp .env.example .env，然后修改所有带【必须修改】的值。
# 生产环境禁止沿用样例中的任何密码；请使用随机生成的强密码。

# ---- MySQL ----
# 【必须修改】数据库 root 密码（仅容器初始化与 healthcheck 用）
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PWD_2026!
# 【必须修改】应用连接数据库使用的账号与密码
MYSQL_USER=pandago
MYSQL_PASSWORD=CHANGE_ME_APP_PWD_2026!
# 宿主机映射端口（可选，默认 3306）
MYSQL_HOST_PORT=3306

# ---- Redis ----
# 【必须修改】Redis 访问密码
REDIS_PASSWORD=CHANGE_ME_REDIS_PWD_2026!
REDIS_HOST_PORT=6379

# ---- JWT ----
# 【必须修改】至少 32 字节随机串；可用命令生成：openssl rand -base64 48
PANDAGO_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_BYTES_LONG
PANDAGO_JWT_EXPIRATION_MS=86400000

# ---- 缓存 / 订单超时 ----
PANDAGO_CACHE_ENABLED=true
PANDAGO_ORDER_TIMEOUT_MINUTES=30

# ---- 服务对外端口（可选）----
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=80
